# LLM Provider configuration: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Model name configuration
# For Gemini: gemini-2.5-flash (default), gemini-2.5-pro, etc.
# For OpenAI: gpt-4o (default), gpt-4o-mini, o1-mini, etc.
LLM_MODEL=gemini-2.5-flash

# API Credentials (provide the one matching your LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
